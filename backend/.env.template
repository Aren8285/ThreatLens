# ThreatLens environment — copy this to .env and fill in your keys.
# AT LEAST ONE LLM key is required for GenAI synthesis + vision OCR.

# ---- AI Providers (auto-detect: Gemini first, then OpenAI) ----------------
GEMINI_API_KEY=            # https://aistudio.google.com/app/apikey  (free tier OK)
OPENAI_API_KEY=            # https://platform.openai.com/api-keys   (fallback)

# Optional: override model tiers
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# ---- OSINT Threat Intel ---------------------------------------------------
# https://www.virustotal.com  → free tier: ~4 lookups/min, 500/day
VIRUSTOTAL_API_KEY=
APIVOID_API_KEY=           # optional, secondary URL reputation engine

# ---- OSINT tuning ----------------------------------------------------------
VT_RATE_PER_MINUTE=4
OSINT_MAX_LOOKUPS_PER_REQUEST=3
OSINT_TIMEOUT_SECONDS=20

# ---- Local ML triage (pre-trained phishing classifier) ---------------------
HF_MODEL_ID=aamoshdahal/email-phishing-distilbert-finetuned
HF_MODEL_REVISION=main
# Set to 1 on air-gapped hosts to skip hub network check
HF_OFFLINE=0
